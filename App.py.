
from fastapi import FastAPI, HTTPException
from database import conectar_banco, criar_tabelas
from models import RegistroCreate, RegistroResponse

app = FastAPI()


@app.on_event("startup")
def iniciar():
    criar_tabelas()


@app.get("/")
def inicio():
    return {"mensagem": "API funcionando!"}


@app.post("/registros", response_model=RegistroResponse)
def criar_registro(registro: RegistroCreate):
    conexao = conectar_banco()
    cursor = conexao.cursor()

    cursor.execute(
        "INSERT INTO registros (titulo, descricao, ativo) VALUES (?, ?, ?)",
        (registro.titulo, registro.descricao, registro.ativo)
    )

    conexao.commit()
    id_registro = cursor.lastrowid
    conexao.close()

    return {**registro.model_dump(), "id": id_registro}


@app.get("/registros", response_model=list[RegistroResponse])
def listar_registros():
    conexao = conectar_banco()
    cursor = conexao.cursor()

    cursor.execute("SELECT * FROM registros")
    registros = cursor.fetchall()

    conexao.close()

    return [dict(registro) for registro in registros]


@app.get("/registros/{id_registro}", response_model=RegistroResponse)
def buscar_registro(id_registro: int):
    conexao = conectar_banco()
    cursor = conexao.cursor()

    cursor.execute(
        "SELECT * FROM registros WHERE id = ?", (id_registro,)
    )
    registro = cursor.fetchone()

    conexao.close()

    if registro is None:
        raise HTTPException(status_code=404, detail="Registro não encontrado")

    return dict(registro)


@app.put("/registros/{id_registro}", response_model=RegistroResponse)
def atualizar_registro(id_registro: int, dados: RegistroCreate):
    conexao = conectar_banco()
    cursor = conexao.cursor()

    cursor.execute(
        """UPDATE registros
        SET titulo = ?, descricao = ?, ativo = ?
        WHERE id = ?""",
        (dados.titulo, dados.descricao, dados.ativo, id_registro)
    )

    conexao.commit()

    if cursor.rowcount == 0:
        conexao.close()
        raise HTTPException(status_code=404, detail="Registro não encontrado")

    conexao.close()

    return {**dados.model_dump(), "id": id_registro}


@app.delete("/registros/{id_registro}")
def excluir_registro(id_registro: int):
    conexao = conectar_banco()
    cursor = conexao.cursor()

    cursor.execute(
        "DELETE FROM registros WHERE id = ?", (id_registro,)
    )

    conexao.commit()

    if cursor.rowcount == 0:
        conexao.close()
        raise HTTPException(status_code=404, detail="Registro não encontrado")

    conexao.close()

    return {"mensagem": "Registro excluído com sucesso"}
